APP_ENV=development
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./karaoketext.db
REDIS_URL=redis://localhost:6379/0
STORAGE_BACKEND=local
STORAGE_PATH=./storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
POSTGRES_PASSWORD=replace-for-local-deployment
# Set to 0 for no application-level upload size limit, or a positive MB value to cap uploads.
MAX_UPLOAD_SIZE_MB=0
MAX_AUDIO_DURATION_SECONDS=3600
JOB_TIMEOUT_SECONDS=7200
FILE_RETENTION_HOURS=168
TRANSCRIPTION_MODEL=small
TRANSCRIPTION_DEVICE=cpu
TRANSCRIPTION_COMPUTE_TYPE=int8
ENABLE_VOCAL_SEPARATION=false
ENABLE_WORD_ALIGNMENT=true
DEFAULT_LANGUAGE=auto
LOG_LEVEL=INFO
